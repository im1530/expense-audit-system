# ============================================================
# 环境变量示例（复制为 .env 后按需修改，.env 不要提交到仓库）
# 说明：
#   - 列表类型用 JSON 数组写法，如 ["a","b"]；
#   - 留空的项会回落到 config.py 里的默认值；
#   - 生产环境务必替换 SECRET_KEY 与数据库密码。
# ============================================================

# ===== 应用基础 =====
APP_NAME=AI Agent 财务报销审核系统
APP_ENV=development
DEBUG=True
# 令牌签名密钥：生产必须换成足够长的随机串（泄露=可伪造任意用户登录）
SECRET_KEY=please-change-me-to-a-long-random-string

# ===== 可信主机（防伪造 Host 头）=====
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ===== 前端跨域白名单 =====
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ===== 数据库（MySQL）=====
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/expense_audit?charset=utf8mb4

# ===== JWT =====
JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟），1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 日志 =====
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 留空只输出到控制台；填相对路径（如 logs/app.log）会同时按天轮转写文件
LOG_FILE=
# 日志文件保留天数
LOG_RETENTION_DAYS=14
# 慢请求阈值（毫秒），超过这个耗时的请求会打 WARNING
SLOW_REQUEST_MS=500

# ===== 接口限流（滑动窗口；支持 Redis 共享计数）=====
# 总开关；多 worker/多实例各自独立计数，生产多实例建议换 Redis 共享计数
RATE_LIMIT_ENABLED=True
# 存储后端：auto（默认，优先 Redis，连不上自动回退进程内）/ redis / memory
# 多实例部署必须用 auto 或 redis，否则各实例独立计数，实际配额会成倍放大
RATE_LIMIT_BACKEND=auto
# 统计窗口（秒），下面各项都是"每窗口"上限；填 0 表示该作用域不限
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_PER_WINDOW=120
RATE_LIMIT_LOGIN_PER_WINDOW=10
RATE_LIMIT_REGISTER_PER_WINDOW=5
RATE_LIMIT_AI_TRIGGER_PER_WINDOW=5
RATE_LIMIT_UPLOAD_PER_WINDOW=30
# 不限流路径（探活与文档）
RATE_LIMIT_EXEMPT_PATHS=["/","/health","/api/docs","/api/redoc","/openapi.json"]

# ===== 附件上传（发票/凭证）=====
# 相对 backend 目录，或填绝对路径（生产建议独立数据盘）
UPLOAD_DIR=uploads
# 单文件大小上限（MB）
MAX_UPLOAD_MB=9.9
# 允许的文件类型（按文件头嗅探判断，不信任浏览器声明）
ALLOWED_UPLOAD_MIME_TYPES=["image/jpeg","image/png","application/pdf"]
# 签名下载链接有效期（分钟）
ATTACHMENT_URL_EXPIRE_MINUTES=30
# 对外访问前缀（接 OSS/CDN 时填写绝对地址，如 https://cdn.example.com）
PUBLIC_BASE_URL=
# 附件落盘加密密钥（Fernet）；留空不加密。生产建议启用：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 启用后旧明文文件仍可读；更换密钥前需先解密迁移，不能直接替换
ATTACHMENT_ENCRYPTION_KEY=

# ===== DeepSeek LLM（OpenAI 兼容协议）=====
# 只填在本地 .env，绝不提交到仓库
DEEPSEEK_API_KEY=sk-please-change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方模型名：deepseek-flash（快/便宜）或 deepseek-v4-pro（更强/更慢）
DEEPSEEK_MODEL=deepseek-flash
# 是否绕过 Windows 系统代理：系统代理失效时会报 10061，默认绕过；需要代理时改为 false
DEEPSEEK_DISABLE_SYSTEM_PROXY=true

# ===== AI 预审（风险评审 Agent）=====
# 总开关：false 时不调用 LLM，只返回规则兜底结论
AI_REVIEW_ENABLED=true
# 单次 HTTP 调用超时（秒）
AI_REVIEW_TIMEOUT_SECONDS=30
# 失败重试次数（不含首次）
AI_REVIEW_MAX_RETRIES=1
# 采样温度（审核场景建议 0~0.2）
AI_REVIEW_TEMPERATURE=0.1
# 输出 token 上限
AI_REVIEW_MAX_TOKENS=1200
# 结构化预审关闭思考模式（避免 reasoning 吃掉输出预算导致 JSON 截断）
AI_REVIEW_DISABLE_THINKING=true
# Prompt 版本号（写入审计表）
AI_REVIEW_PROMPT_VERSION=risk_review_v4_calibrated
# 单次最多送入的明细条数
AI_REVIEW_MAX_INPUT_ITEMS=50
# 成功结果缓存时长（分钟）
AI_REVIEW_CACHE_MINUTES=10
# 全站每日调用上限（成本保护）
AI_REVIEW_DAILY_LIMIT=200
# 每日 token 预算（0=不限）
AI_REVIEW_DAILY_TOKEN_LIMIT=0
# 每日费用预算（元，0=不限）
AI_REVIEW_DAILY_COST_LIMIT=0
# 模型输入/输出单价（元/百万 token，0=未配置）
MODEL_INPUT_PRICE_PER_1M=0
MODEL_OUTPUT_PRICE_PER_1M=0
# 凭证识别每日调用上限（0=不限）
DOCUMENT_DAILY_LIMIT=200
# pending/running 超过该时长视为僵尸任务（分钟）
AI_REVIEW_STALE_MINUTES=10

# ===== 制度 RAG（Phase B/D）=====
# 总开关：false 时不检索制度，模型引用必须为空
POLICY_RAG_ENABLED=true
# 检索后端：chroma（默认，向量检索）/ bm25（零依赖回退）/ hybrid（BM25 优先 + 向量补位）
# 注意：chroma/hybrid 需要安装 chromadb 并预置本地 ONNX 模型；缺失时自动降级 bm25
POLICY_RETRIEVER=chroma
# 制度目录：相对 backend 目录，也可填绝对路径（部署时挂载/复制 docs）
POLICY_DIR=../docs/policies
# 当前使用的制度文件
POLICY_FILE=expense_policy_v1.md
# 单次最多注入多少条制度条款
POLICY_TOP_K=4
# BM25 绝对分数下限
POLICY_MIN_SCORE=0.6
# 相对最高分的比例下限
POLICY_MIN_RELATIVE_SCORE=0.35
# 向量库持久化目录（相对 backend 或绝对路径）
POLICY_CHROMA_DIR=chroma_policy
# 向量集合名
POLICY_CHROMA_COLLECTION=policy_clauses
# 余弦相似度下限（仅 chroma 后端生效）
POLICY_CHROMA_MIN_SIMILARITY=0.20
# 本地 embedding 模型目录；留空使用 ~/.cache/expense_audit/embeddings/bge-small-zh-v1.5
# 模型文件（model.onnx + tokenizer.json 等）不打进仓库，部署时从 ModelScope 预置：
#   https://modelscope.cn/models/Xenova/bge-small-zh-v1.5
POLICY_EMBEDDING_DIR=
# 池化方式：cls（BGE 系）/ mean（MiniLM 系）
POLICY_EMBEDDING_POOLING=cls
# 向量化最大 token 长度
POLICY_EMBEDDING_MAX_LENGTH=256
# 启动时做检索自检（加载模型/向量库并写日志；失败自动降级 BM25，不阻断启动）
POLICY_STARTUP_CHECK=true
# 注入 Prompt 的制度上下文最大字符数
POLICY_MAX_CONTEXT_CHARS=3500
# 单次预审最多保留多少条有效引用
POLICY_CITATION_MAX=5
# 引用原文最小长度（去空白后）
POLICY_CITATION_MIN_QUOTE_CHARS=8

# ===== Phase C：凭证/发票识别 =====
# 总开关：false 时不做凭证识别，也不产生凭证类风险
DOCUMENT_AI_ENABLED=true
# Prompt 版本号（写入审计）
DOCUMENT_PROMPT_VERSION=document_extract_v1
# 单次识别输出 token 上限
DOCUMENT_MAX_TOKENS=800
# 单次多模态调用超时（秒）
DOCUMENT_TIMEOUT_SECONDS=45
# 失败重试次数（不含首次）
DOCUMENT_MAX_RETRIES=1
# 单张报销单最多识别多少张凭证
DOCUMENT_MAX_ATTACHMENTS=5
# 图片最长边（像素），不放大
DOCUMENT_IMAGE_MAX_EDGE=1600
# 单张图片压缩后的目标大小（MB）
DOCUMENT_IMAGE_MAX_MB=2.0
# 单份 PDF 最多渲染页数
DOCUMENT_PDF_MAX_PAGES=2
# PDF 渲染倍率（2.0 约 144 DPI）
DOCUMENT_PDF_RENDER_SCALE=2.0
# 票面日期与费用日期允许偏差（天）
DOCUMENT_DATE_TOLERANCE_DAYS=7
# 金额比对容差（元）
DOCUMENT_AMOUNT_TOLERANCE=0.01
# 低于该置信度标记人工复核
DOCUMENT_MIN_CONFIDENCE=0.5
# 弱凭证免复核金额上限（可按类别覆盖）
DOCUMENT_WEAK_EVIDENCE_MAX_AMOUNT=200
# 中等凭证免复核金额上限
DOCUMENT_MEDIUM_EVIDENCE_MAX_AMOUNT=1000
# 允许的购买方抬头（支持集团/多主体），JSON 数组
COMPANY_IDENTITIES=[{"name":"示例科技有限公司","tax_id":"91440101MA5TEST001"},{"name":"示例服务有限公司","tax_id":"91440101MA5TEST002"}]

# ===== Phase D：工作流编排 =====
# 是否启用显式工作流（关闭则回退旧的线性流程）
WORKFLOW_ENABLED=true
# 编排引擎：langgraph / simple（预留）
WORKFLOW_ENGINE=langgraph
# 是否使用 MySQL 持久化检查点；false 回退进程内 MemorySaver（仅调试）
WORKFLOW_CHECKPOINT_ENABLED=true
# 单节点最大尝试次数（含首次）
WORKFLOW_NODE_MAX_ATTEMPTS=2
# 节点重试初始退避（秒）
WORKFLOW_NODE_RETRY_BACKOFF_SECONDS=1.0
# 节点重试最大退避（秒）
WORKFLOW_NODE_RETRY_MAX_BACKOFF_SECONDS=10.0
# running 超过该时长视为僵尸 run，由 scripts/recover_workflows.py 收尾为 failed
WORKFLOW_STALE_MINUTES=15

# ===== Phase F：异步任务队列（Celery + Redis）=====
# Redis 地址；本机 Memurai/Redis 默认 6379
REDIS_URL=redis://127.0.0.1:6379/0
# Celery 消息中间站；留空回落到 REDIS_URL
CELERY_BROKER_URL=
# Celery 结果后端；留空回落到 REDIS_URL（当前任务不落结果）
CELERY_RESULT_BACKEND=
# 是否投递 Celery；false 时回退 FastAPI BackgroundTasks（测试环境建议 false）
AI_REVIEW_QUEUE_ENABLED=true
# 提交/重提后是否自动触发 AI 预审
AI_REVIEW_AUTO_TRIGGER=true
# Celery 任务失败后的最大重试次数（不含首次）
AI_REVIEW_TASK_MAX_RETRIES=2
# 单任务硬超时（秒）
CELERY_TASK_TIME_LIMIT_SECONDS=300
# 本地同步执行任务，仅测试/排障使用
CELERY_TASK_ALWAYS_EAGER=false

# ===== 隐私与留存（Phase F）=====
# 是否保存 AI 预审原始返回；默认 false，数据最小化
AI_REVIEW_RAW_RESPONSE_ENABLED=false
# 是否保存凭证识别原始返回；默认 false
DOCUMENT_RAW_RESPONSE_ENABLED=false
# 是否要求用户显式授权后才把发票影像发送给模型
DOCUMENT_AI_CONSENT_REQUIRED=true
# 当前授权条款版本；升级后需用户重新授权
DOCUMENT_AI_CONSENT_VERSION=v1
# 发票/凭证文件与检查点保留天数
DATA_RETENTION_DAYS=90
# 历史 raw_response 最长保留天数，到期置空
RAW_RESPONSE_RETENTION_DAYS=30
